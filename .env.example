# Google Sheets — devoluciones
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=
GOOGLE_CREDENTIALS_PATH=./config/google-credentials.json

# Google Sheets — consolidado conductores
CONSOLIDADO_SHEET_ID=
CONSOLIDADO_SHEET_GID=

# Google Sheets — Consolidado Altas OB (Onboarding → Altas)
# Opcional: por defecto ya apunta a la planilla real. Solo se necesita
# setear si algún día cambia de ID/pestaña. Debe estar compartida (Lector)
# con el mismo correo de la Service Account que usan las otras hojas.
ALTAS_OB_SHEET_ID=
ALTAS_OB_SHEET_GID=

# Panel de control
PANEL_USER=admin
PANEL_PASSWORD=cambiar_esto
SESSION_SECRET=generar_con__openssl_rand_hex_32
PORT=3000

# Overrides manuales de telefono (opcional)
# Solo agregar patentes que no esten en contactos_conductores.csv
# o que tengan un numero incorrecto en el consolidado.
# Formato: PATENTE_XXXX=56912345678 (sin +, sin espacios, con codigo de pais)
# PATENTE_XXXX=56912345678
